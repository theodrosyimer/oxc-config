{
  "name": "@thyi/oxc-config",
  "version": "3.0.3",
  "description": "Oxlint + Oxfmt config for TypeScript, Node.js, React, React Native (successor of @thyi/eslint-config)",
  "keywords": [
    "config",
    "format",
    "lint",
    "oxc",
    "oxfmt",
    "oxlint",
    "react",
    "react-native",
    "typescript"
  ],
  "license": "MIT",
  "author": "Theodros Yimer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theodrosyimer/oxc-config.git"
  },
  "type": "module",
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./turbo": {
      "types": "./turbo.d.ts",
      "default": "./turbo.js"
    },
    "./only-warn": {
      "types": "./only-warn.d.ts",
      "default": "./only-warn.js"
    },
    "./oxfmt": {
      "types": "./oxfmt.d.ts",
      "default": "./oxfmt.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "release": "release-it"
  },
  "dependencies": {
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-turbo": "^2.10.11"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "12.0.0",
    "release-it": "21.0.2"
  },
  "peerDependencies": {
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
