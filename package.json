{
  "name": "@thyi/oxc-config",
  "version": "4.1.0",
  "description": "Oxlint + Oxfmt config for TypeScript, Node.js, React, React Native (successor of @thyi/eslint-config)",
  "keywords": [
    "config",
    "format",
    "lint",
    "oxc",
    "oxfmt",
    "oxlint",
    "react",
    "react-native",
    "typescript"
  ],
  "homepage": "https://github.com/theodrosyimer/oxc-config#readme",
  "bugs": {
    "url": "https://github.com/theodrosyimer/oxc-config/issues"
  },
  "license": "MIT",
  "author": "Theodros Yimer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theodrosyimer/oxc-config.git"
  },
  "files": [
    "CHANGELOG.md",
    "base.d.ts",
    "base.js",
    "default.d.ts",
    "default.js",
    "index.d.ts",
    "index.js",
    "oxfmt.d.ts",
    "oxfmt.js",
    "react-web.d.ts",
    "react-web.js",
    "react.d.ts",
    "react.js",
    "turbo.d.ts",
    "turbo.js",
    "react-native/",
    "!react-native/**/*.test.js"
  ],
  "type": "module",
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./react-web": {
      "types": "./react-web.d.ts",
      "default": "./react-web.js"
    },
    "./turbo": {
      "types": "./turbo.d.ts",
      "default": "./turbo.js"
    },
    "./oxfmt": {
      "types": "./oxfmt.d.ts",
      "default": "./oxfmt.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "release": "release-it",
    "test": "vitest run"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.88.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-turbo": "^2.10.11"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "12.0.0",
    "release-it": "21.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": ">=0.5.0",
    "tailwindcss": "^3.3.0 || ^4.1.17"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
